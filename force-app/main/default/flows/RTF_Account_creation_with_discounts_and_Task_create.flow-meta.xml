        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>ALF_Subflow_Create_task_for_rating</flowName>
        <inputAssignments>
            <name>varT_Rating</name>
            <value>
                <elementReference>$Record.Rating</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varT_recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
