    <decisions>
        <description>Checking the lead source</description>
        <name>Lead_Source</name>
        <label>Lead Source?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>CreateLead</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Others</defaultConnectorLabel>
        <rules>
            <name>Lead_Source_Partner_Referral</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Lead_sources</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Partner Referral</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Rating_Hot</targetReference>
            </connector>
            <label>Lead Source = Partner Referral</label>
        </rules>
        <rules>
            <name>Lead_Source_Web</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Lead_sources</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Web</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Rating_Warm</targetReference>
            </connector>
            <label>Lead Source = Web</label>
        </rules>
    </decisions>
