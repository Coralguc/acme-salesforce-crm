    <decisions>
        <name>ATM_PIN_valid</name>
        <label>ATM PIN valid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Others</defaultConnectorLabel>
        <rules>
            <name>PIN_valid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Enter_your_Pin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varN_Pin</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ATM_Screen1</targetReference>
            </connector>
            <label>PIN valid</label>
        </rules>
        <rules>
            <name>PIN_Invalid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Enter_your_Pin</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>varN_Pin</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invalid_PIN</targetReference>
            </connector>
            <label>PIN Invalid</label>
        </rules>
    </decisions>
    <decisions>
        <name>funds_available</name>
        <label>funds available</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>after_withdraw</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Funds=Yes</defaultConnectorLabel>
        <rules>
            <name>Funds_notAvailable</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Enter_the_amount_to_withdraw</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>varN_funds</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Insufficient_funds_screen</targetReference>
            </connector>
            <label>Funds=notAvailable</label>
        </rules>
    </decisions>
    <decisions>
        <name>Options</name>
        <label>Options</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Others</defaultConnectorLabel>
        <rules>
            <name>Withdraw_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Select_your_choice</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>with_choice</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ATM_withdrawal_screen</targetReference>
            </connector>
            <label>Withdraw=Yes</label>
        </rules>
        <rules>
            <name>Deposit_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Select_your_choice</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Depo_Choice</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>deposit_screen</targetReference>
            </connector>
            <label>Deposit=Yes</label>
        </rules>
        <rules>
            <name>Show_your_Balance</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Select_your_choice</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Show_Choice</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen3_Account_Balance</targetReference>
            </connector>
            <label>Show your Balance</label>
        </rules>
    </decisions>
