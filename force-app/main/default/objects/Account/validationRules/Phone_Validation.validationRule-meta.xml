<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Phone_Validation</fullName>
    <active>false</active>
    <errorConditionFormula>AND( AnnualRevenue &gt; 200000, ISBLANK(Phone) )</errorConditionFormula>
    <errorDisplayField>Phone</errorDisplayField>
    <errorMessage>Phone Number cannot be blank</errorMessage>
</ValidationRule>
