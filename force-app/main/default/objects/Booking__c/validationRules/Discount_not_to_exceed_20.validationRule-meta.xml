<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Discount_not_to_exceed_20</fullName>
    <active>true</active>
    <description>Discount limit is with 20%, should not exceed</description>
    <errorConditionFormula>Discount__c &gt; 0.2</errorConditionFormula>
    <errorDisplayField>Discount__c</errorDisplayField>
    <errorMessage>Discount cannot be greater than 20%</errorMessage>
</ValidationRule>
