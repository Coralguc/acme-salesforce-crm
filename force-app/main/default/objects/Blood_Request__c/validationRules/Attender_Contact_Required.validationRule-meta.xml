<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Attender_Contact_Required</fullName>
    <active>true</active>
    <description>Make the attender contact required when attender name is entered</description>
    <errorConditionFormula>AND(

  NOT(ISBLANK( Attender_Name__c)),

 ISBLANK( Attender_Contact__c)
)</errorConditionFormula>
    <errorDisplayField>Attender_Contact__c</errorDisplayField>
    <errorMessage>Attender Phone Number is required</errorMessage>
</ValidationRule>
